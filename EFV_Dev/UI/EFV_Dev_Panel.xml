	<Instance Name="DevButtonInstance">
		<GridButton ID="Button" Size="136,26" SliceCorner="12,12" SliceSize="1,1" SliceTextureSize="24,24" Texture="Controls_ButtonControl_Brown" StateOffsetIncrement="0,24" Style="FontNormal12" TextColor="230,220,200,255" String=""/>
